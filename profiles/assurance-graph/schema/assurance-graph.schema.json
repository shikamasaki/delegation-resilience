{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delegation-resilience.org/schemas/assurance-graph/v0alpha1/assurance-graph.schema.json",
  "title": "Delegation Resilience Assurance Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "sourceArtifacts", "nodes", "edges"],
  "properties": {
    "apiVersion": { "const": "delegation-resilience.org/assurance-graph/v0alpha1" },
    "kind": { "const": "AssuranceGraph" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphId", "createdAt", "canonicalization"],
      "properties": {
        "graphId": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "canonicalization": { "const": "RFC8785-JCS" }
      }
    },
    "sourceArtifacts": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/sourceArtifact" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "uri", "digest", "observedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^src:[A-Za-z0-9._/-]+$" },
        "uri": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "observedAt": { "type": "string", "format": "date-time" },
        "validFrom": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "sourceRefs"],
      "properties": {
        "mode": { "enum": ["observed", "inferred", "derived"] },
        "sourceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "observedAt": { "type": "string", "format": "date-time" },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "sourceRefs", "assurance", "provenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._:/-]*$" },
        "type": { "enum": ["intent", "attempt", "actor", "capability", "external_effect", "evidence", "attestation", "claim", "dependency", "exercise", "artifact"] },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "artifactDigest": { "$ref": "#/$defs/digest" },
        "observedAt": { "type": "string", "format": "date-time" },
        "validFrom": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "assurance": { "enum": ["observed", "inferred", "derived"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "attributes": { "type": "object" }
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "from", "to", "sourceRefs", "assurance", "provenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._:/-]*$" },
        "type": { "enum": ["attempts", "uses", "produces", "observes", "reconciles", "supports", "depends_on", "invalidates", "shares_fate_with", "hands_off_to", "produces_artifact"] },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "artifactDigest": { "$ref": "#/$defs/digest" },
        "observedAt": { "type": "string", "format": "date-time" },
        "validFrom": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "assurance": { "enum": ["observed", "inferred", "derived"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "attributes": { "type": "object" }
      }
    }
  }
}
