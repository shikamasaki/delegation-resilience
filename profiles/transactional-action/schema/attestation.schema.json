{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExerciseAttestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "evaluatedProfile", "scenarioRef", "issuer", "issuedAt", "validUntil", "exerciseMode", "startedAt", "completedAt", "systemUnderTest", "actualConditions", "humanParticipation", "claimResults", "measurements", "evidence", "evidenceGaps", "residualUncertainty"],
  "properties": {
    "apiVersion": { "const": "delegation-resilience.org/v0alpha1" },
    "kind": { "const": "ExerciseAttestation" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "evaluatedProfile": { "$ref": "common.schema.json#/$defs/artifactReference" },
    "scenarioRef": { "type": "string", "minLength": 1 },
    "issuer": { "$ref": "common.schema.json#/$defs/identity" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "exerciseMode": { "$ref": "common.schema.json#/$defs/exerciseMode" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "systemUnderTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "components"],
      "properties": {
        "environment": { "type": "string", "minLength": 1 },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["componentId", "kind", "version"],
            "properties": {
              "componentId": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "artifact": { "$ref": "common.schema.json#/$defs/artifactReference" }
            }
          }
        }
      }
    },
    "actualConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["faultSchedule", "workload", "sharedDependencies"],
      "properties": {
        "randomSeed": { "type": "string", "minLength": 1 },
        "faultSchedule": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["faultId", "target", "startedAt", "completedAt"],
            "properties": {
              "faultId": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 },
              "startedAt": { "type": "string", "format": "date-time" },
              "completedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "workload": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/measurement" }
        },
        "sharedDependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "humanParticipation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "participantCount", "roles", "participants", "authorityVerified", "authorityEvidence", "operationalAccessVerified", "operationalAccessEvidence"],
      "properties": {
        "mode": { "enum": ["none", "simulated", "facilitated", "live"] },
        "participantCount": { "type": "integer", "minimum": 0 },
        "roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["participantId", "role", "simulated", "qualified", "qualificationEvidence"],
            "properties": {
              "participantId": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "simulated": { "type": "boolean" },
              "qualified": { "type": "boolean" },
              "qualificationEvidence": { "$ref": "common.schema.json#/$defs/artifactReference" }
            }
          }
        },
        "authorityVerified": { "type": "boolean" },
        "authorityEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/participantEvidence" }
        },
        "operationalAccessVerified": { "type": "boolean" },
        "operationalAccessEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/participantEvidence" }
        },
        "observations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "claimResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimRef", "result", "demonstratedCapabilities", "capabilityEvidence", "measurementRefs", "evidenceRequirementRefs"],
        "properties": {
          "claimRef": { "type": "string", "minLength": 1 },
          "result": { "enum": ["demonstrated", "not_demonstrated", "failed", "inconclusive"] },
          "demonstratedCapabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/recoveryCapability" }
          },
          "capabilityEvidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/capabilityEvidence" }
          },
          "measurementRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidenceRequirementRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/measurement" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceObservationId", "evidenceRequirementRef", "finding", "artifact", "observedAt"],
        "properties": {
          "evidenceObservationId": { "type": "string", "minLength": 1 },
          "evidenceRequirementRef": { "type": "string", "minLength": 1 },
          "finding": { "enum": ["satisfied", "contradicted", "unavailable", "inconclusive"] },
          "artifact": { "$ref": "common.schema.json#/$defs/artifactReference" },
          "observedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "evidenceGaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "residualUncertainty": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "capabilityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "measurementRefs", "evidenceRequirementRefs"],
      "properties": {
        "capability": { "$ref": "common.schema.json#/$defs/recoveryCapability" },
        "measurementRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceRequirementRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "participantEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participantRef", "artifact"],
      "properties": {
        "participantRef": { "type": "string", "minLength": 1 },
        "artifact": { "$ref": "common.schema.json#/$defs/artifactReference" }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurementId", "metric", "value", "unit"],
      "properties": {
        "measurementId": { "type": "string", "minLength": 1 },
        "metric": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "integer", "string", "boolean"] },
        "unit": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "exerciseMode": { "const": "deterministic_simulation" } } },
      "then": {
        "properties": {
          "humanParticipation": {
            "properties": {
              "mode": { "enum": ["none", "simulated"] },
              "authorityVerified": { "const": false },
              "operationalAccessVerified": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "humanParticipation": {
            "properties": { "mode": { "const": "none" } }
          }
        }
      },
      "then": {
        "properties": {
          "humanParticipation": {
            "properties": {
              "participantCount": { "const": 0 },
              "roles": { "maxItems": 0 },
              "authorityVerified": { "const": false },
              "operationalAccessVerified": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "humanParticipation": {
            "properties": { "mode": { "enum": ["facilitated", "live"] } }
          }
        }
      },
      "then": {
        "properties": {
          "humanParticipation": {
            "properties": { "participantCount": { "minimum": 1 } }
          }
        }
      }
    }
  ]
}
