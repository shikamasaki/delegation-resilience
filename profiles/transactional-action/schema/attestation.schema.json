{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExerciseAttestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "evaluatedProfile", "scenarioRef", "issuer", "issuedAt", "claimResults", "evidence", "residualUncertainty"],
  "properties": {
    "apiVersion": { "const": "delegation-resilience.org/v0alpha1" },
    "kind": { "const": "ExerciseAttestation" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "evaluatedProfile": { "$ref": "common.schema.json#/$defs/artifactReference" },
    "scenarioRef": { "type": "string", "minLength": 1 },
    "issuer": { "$ref": "common.schema.json#/$defs/identity" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "claimResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimRef", "result"],
        "properties": {
          "claimRef": { "type": "string", "minLength": 1 },
          "result": { "enum": ["demonstrated", "not_demonstrated", "failed", "inconclusive"] },
          "notes": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/artifactReference" }
    },
    "residualUncertainty": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
