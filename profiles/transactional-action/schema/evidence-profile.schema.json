{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "requirements"],
  "properties": {
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "stage", "source", "epistemicKind", "freshness", "missingDisposition"],
        "properties": {
          "evidenceId": { "type": "string", "minLength": 1 },
          "stage": { "enum": ["precondition", "decision", "commit", "external_outcome", "recovery", "exercise"] },
          "source": { "type": "string", "minLength": 1 },
          "epistemicKind": { "enum": ["asserted", "observed", "inferred", "reconciled"] },
          "freshness": { "type": "string", "minLength": 1 },
          "independenceNotes": { "type": "string" },
          "missingDisposition": { "enum": ["warn", "defer", "deny", "halt", "reconcile"] }
        }
      }
    }
  }
}
