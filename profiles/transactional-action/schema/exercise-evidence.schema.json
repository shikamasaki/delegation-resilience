{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExerciseEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "scenarioRef", "environmentRef", "issuer", "observedAt", "validUntil", "assurance", "assertions", "payload"],
  "properties": {
    "apiVersion": { "const": "delegation-resilience.org/v0alpha1" },
    "kind": { "const": "ExerciseEvidence" },
    "scenarioRef": { "type": "string", "minLength": 1 },
    "environmentRef": { "type": "string", "minLength": 1 },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["human", "service", "workload", "organization"] }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "assurance": { "const": "digest_bound" },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceRequirementRef", "finding"],
        "properties": {
          "evidenceRequirementRef": { "type": "string", "minLength": 1 },
          "finding": { "enum": ["satisfied", "contradicted", "unavailable", "inconclusive"] }
        }
      }
    },
    "payload": {}
  }
}
