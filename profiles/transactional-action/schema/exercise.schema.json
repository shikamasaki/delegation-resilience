{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExerciseSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "scenarioId", "claimRefs", "exerciseMode", "executionPlan", "injects", "expectedObservations", "passCriteria", "measurementConditions"],
  "properties": {
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "scenarioId": { "type": "string", "minLength": 1 },
    "claimRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "exerciseMode": { "$ref": "common.schema.json#/$defs/exerciseMode" },
    "executionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["randomSeed", "parameters", "sharedDependencies"],
      "properties": {
        "randomSeed": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value", "unit"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": { "type": ["number", "integer", "string", "boolean"] },
              "unit": { "type": "string", "minLength": 1 }
            }
          }
        },
        "sharedDependencies": {
          "type": "array",
          "description": "Dependency labels unless dependencyAnalysisRequired is true; when true, every item is a component reference in dependencyTopology.",
          "items": { "type": "string", "minLength": 1 }
        },
        "dependencyAnalysisRequired": {
          "type": "boolean",
          "description": "When true, dependencyTopology is mandatory and sharedDependencies plus inject targets are checked as topology references."
        },
        "dependencyTopology": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["componentId", "role", "dependencyRefs"],
            "properties": {
              "componentId": { "type": "string", "minLength": 1 },
              "role": {
                "enum": [
                  "primary_execution",
                  "fallback_execution",
                  "authorization",
                  "external_outcome",
                  "human_handover",
                  "evidence",
                  "other"
                ]
              },
              "dependencyRefs": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "humanEvidenceBindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["qualification", "authority", "operationalAccess"],
          "properties": {
            "qualification": { "$ref": "#/$defs/humanEvidenceBinding" },
            "authority": { "$ref": "#/$defs/humanEvidenceBinding" },
            "operationalAccess": { "$ref": "#/$defs/humanEvidenceBinding" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["dependencyAnalysisRequired"],
            "properties": {
              "dependencyAnalysisRequired": { "const": true }
            }
          },
          "then": { "required": ["dependencyTopology"] }
        }
      ]
    },
    "injects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atOffset", "duration", "target", "fault"],
        "properties": {
          "atOffset": { "type": "string", "minLength": 1 },
          "duration": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "fault": { "type": "string", "minLength": 1 }
        }
      }
    },
    "expectedObservations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "passCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "measurementConditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "humanEvidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectRef", "covers"],
      "properties": {
        "objectRef": { "type": "string", "minLength": 1 },
        "covers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
