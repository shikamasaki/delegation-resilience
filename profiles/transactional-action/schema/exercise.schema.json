{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExerciseSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "scenarioId", "claimRefs", "injects", "expectedObservations", "passCriteria", "measurementConditions"],
  "properties": {
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "scenarioId": { "type": "string", "minLength": 1 },
    "claimRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "injects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "fault"],
        "properties": {
          "at": { "type": "string", "minLength": 1 },
          "fault": { "type": "string", "minLength": 1 }
        }
      }
    },
    "expectedObservations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "passCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "measurementConditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
