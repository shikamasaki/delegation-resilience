{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HumanDrillEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "scenarioRef", "environmentRef", "evidenceType", "subjectRefs", "objectRef", "finding", "covers", "issuer", "observedAt", "validUntil", "assurance"],
  "properties": {
    "apiVersion": { "enum": ["delegation-resilience.org/v0alpha1", "delegation-resilience.org/v0alpha2"] },
    "kind": { "const": "HumanDrillEvidence" },
    "scenarioRef": { "type": "string", "minLength": 1 },
    "environmentRef": { "type": "string", "minLength": 1 },
    "evidenceType": { "enum": ["qualification", "authority", "operational_access", "channel_independence", "participant_safeguard", "participant_acknowledgement", "withdrawal_status", "facilitator_assignment", "abort_authority_assignment", "handover_observation", "human_task_outcome"] },
    "subjectRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "objectRef": { "type": "string", "minLength": 1 },
    "finding": { "enum": ["satisfied", "declined", "withdrawn"] },
    "participantDecision": { "enum": ["acknowledged", "declined"] },
    "participantStatus": { "enum": ["active", "withdrawn"] },
    "statementSequence": { "type": "integer", "minimum": 1 },
    "preflightRunId": { "type": "string", "minLength": 8 },
    "challenge": { "type": "string", "minLength": 16 },
    "profileDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "preflightContextDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "briefingArtifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "covers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["human", "service", "workload", "organization"] }
      }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" }
    ,
    "assurance": { "const": "digest_bound" }
  },
  "allOf": [
    {
      "if": { "properties": { "apiVersion": { "const": "delegation-resilience.org/v0alpha1" } }, "required": ["apiVersion"] },
      "then": {
        "properties": {
          "evidenceType": { "enum": ["qualification", "authority", "operational_access", "channel_independence", "participant_safeguard"] },
          "finding": { "const": "satisfied" }
        },
        "not": { "anyOf": [{ "required": ["participantDecision"] }, { "required": ["participantStatus"] }] }
      }
    },
    {
      "if": { "properties": { "apiVersion": { "const": "delegation-resilience.org/v0alpha2" }, "evidenceType": { "const": "participant_acknowledgement" } }, "required": ["apiVersion", "evidenceType"] },
      "then": { "required": ["participantDecision", "statementSequence", "preflightRunId", "challenge", "profileDigest", "preflightContextDigest", "briefingArtifactDigest"] }
    },
    {
      "if": { "properties": { "apiVersion": { "const": "delegation-resilience.org/v0alpha2" }, "evidenceType": { "const": "withdrawal_status" } }, "required": ["apiVersion", "evidenceType"] },
      "then": { "required": ["participantStatus", "statementSequence", "preflightRunId", "challenge", "profileDigest", "preflightContextDigest", "briefingArtifactDigest"] }
    },
    {
      "if": { "properties": { "participantDecision": { "const": "acknowledged" } }, "required": ["participantDecision"] },
      "then": { "properties": { "finding": { "const": "satisfied" } } }
    },
    {
      "if": { "properties": { "participantDecision": { "const": "declined" } }, "required": ["participantDecision"] },
      "then": { "properties": { "finding": { "const": "declined" } } }
    },
    {
      "if": { "properties": { "participantStatus": { "const": "active" } }, "required": ["participantStatus"] },
      "then": { "properties": { "finding": { "const": "satisfied" } } }
    },
    {
      "if": { "properties": { "participantStatus": { "const": "withdrawn" } }, "required": ["participantStatus"] },
      "then": { "properties": { "finding": { "const": "withdrawn" } } }
    },
    {
      "if": {
        "properties": {
          "apiVersion": { "const": "delegation-resilience.org/v0alpha2" },
          "evidenceType": { "enum": ["qualification", "authority", "operational_access", "channel_independence", "participant_safeguard", "facilitator_assignment", "abort_authority_assignment", "handover_observation", "human_task_outcome"] }
        },
        "required": ["apiVersion", "evidenceType"]
      },
      "then": { "properties": { "finding": { "const": "satisfied" } } }
    }
  ]
}
