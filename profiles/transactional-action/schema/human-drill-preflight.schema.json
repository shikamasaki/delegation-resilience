{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HumanDrillPreflight",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "scenarioRef", "sandboxEnvironmentId", "facilitatorId", "participants", "authorityVerifications", "operationalAccessVerifications", "operatorChannelIndependenceEvidence", "participantSafeguardEvidence", "controls"],
  "properties": {
    "apiVersion": { "enum": ["delegation-resilience.org/v0alpha1", "delegation-resilience.org/v0alpha2"] },
    "kind": { "const": "HumanDrillPreflight" },
    "scenarioRef": { "type": "string", "minLength": 1 },
    "sandboxEnvironmentId": { "type": "string" },
    "preflightRunId": { "type": "string", "minLength": 8 },
    "challenge": { "type": "string", "minLength": 16 },
    "facilitatorId": { "type": "string" },
    "abortAuthorityId": { "type": "string", "minLength": 1 },
    "facilitatorAssignmentEvidence": { "$ref": "#/$defs/artifactReference" },
    "abortAuthorityAssignmentEvidence": { "$ref": "#/$defs/artifactReference" },
    "briefingArtifact": { "$ref": "#/$defs/artifactReference" },
    "participantDataUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "audiences", "retentionUntil"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "audiences": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "retentionUntil": { "type": "string", "format": "date-time" }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participantId", "simulated", "qualificationEvidence"],
        "properties": {
          "participantId": { "type": "string", "minLength": 1 },
          "simulated": { "type": "boolean" },
          "qualificationEvidence": { "$ref": "#/$defs/artifactReference" }
        }
      }
    },
    "authorityVerifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/participantVerification" }
    },
    "operationalAccessVerifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/participantVerification" }
    },
    "operatorChannelIndependenceEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["covers", "evidence"],
        "properties": {
          "covers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["identity", "policy", "provider_outcome", "agent_connector"] }
          },
          "evidence": { "$ref": "#/$defs/artifactReference" }
        }
      }
    },
    "participantSafeguardEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["covers", "evidence"],
        "properties": {
          "covers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["briefing_consent", "data_use_retention", "operator_abort_rights", "fatigue_shift_plan"] }
          },
          "evidence": { "$ref": "#/$defs/artifactReference" }
        }
      }
    },
    "participantAcknowledgements": {
      "type": "array",
      "items": { "$ref": "#/$defs/participantVerification" }
    },
    "withdrawalStatusEvidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/participantVerification" }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["faultInjectionApproved", "providerSandboxReady", "evidenceSinkReady", "handoverTimerReady", "missionClockReady", "abortAuthorityAssigned", "participantBriefingAndConsentRecorded", "operatorAbortRightsConfirmed", "fatigueAndShiftPlanReady"],
      "properties": {
        "faultInjectionApproved": { "type": "boolean" },
        "providerSandboxReady": { "type": "boolean" },
        "evidenceSinkReady": { "type": "boolean" },
        "handoverTimerReady": { "type": "boolean" },
        "missionClockReady": { "type": "boolean" },
        "abortAuthorityAssigned": { "type": "boolean" },
        "participantBriefingAndConsentRecorded": { "type": "boolean" },
        "operatorAbortRightsConfirmed": { "type": "boolean" },
        "fatigueAndShiftPlanReady": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "apiVersion": { "const": "delegation-resilience.org/v0alpha2" } }, "required": ["apiVersion"] },
      "then": { "required": ["preflightRunId", "challenge", "abortAuthorityId", "facilitatorAssignmentEvidence", "abortAuthorityAssignmentEvidence", "briefingArtifact", "participantDataUse", "participantAcknowledgements", "withdrawalStatusEvidence"] }
    }
  ],
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        ,
        "proof": { "$ref": "#/$defs/proofReference" }
      }
    },
    "proofReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "participantVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participantRef", "evidence"],
      "properties": {
        "participantRef": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/artifactReference" }
      }
    }
  }
}
