{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MissionSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "outcome", "owner", "beneficiaries", "affectedParties", "criticalFunctions", "impactTolerances"],
  "properties": {
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "outcome": { "type": "string", "minLength": 1 },
    "owner": { "$ref": "common.schema.json#/$defs/identity" },
    "beneficiaries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "affectedParties": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "criticalFunctions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "impactTolerances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "operator", "value", "unit"],
        "properties": {
          "dimension": { "type": "string", "minLength": 1 },
          "operator": { "enum": ["max", "min", "exact"] },
          "value": { "type": ["number", "integer", "string"] },
          "unit": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
