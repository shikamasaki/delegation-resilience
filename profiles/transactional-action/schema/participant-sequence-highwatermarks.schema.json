{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Participant statement sequence high-watermarks",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "trustPolicyRef", "trustPolicySequenceNumber", "preflightRunId", "challenge", "participantStatements"],
  "properties": {
    "apiVersion": { "const": "delegation-resilience.org/v0alpha2" },
    "kind": { "const": "ParticipantSequenceHighWatermarks" },
    "trustPolicyRef": { "type": "string", "minLength": 1 },
    "trustPolicySequenceNumber": { "type": "integer", "minimum": 1 },
    "preflightRunId": { "type": "string", "minLength": 8 },
    "challenge": { "type": "string", "minLength": 16 },
    "participantStatements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "status", "statementDigest"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["active", "withdrawn"] },
          "statementDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    }
  }
}
